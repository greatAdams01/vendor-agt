# ChoopAgent backend settings (copy to .env)
# Database
DATABASE_URL=postgresql+psycopg://chopagent:chopagent@localhost:5432/chopagent

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me

# Outbound message templates (must be pre-approved in Meta Business Manager).
# Used for proactive sends outside the 24-hour customer service window.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_NEW_ORDER=new_paid_order
WHATSAPP_TEMPLATE_ON_THE_WAY=order_on_the_way
WHATSAPP_TEMPLATE_DELIVERED=order_delivered
WHATSAPP_TEMPLATE_FEE_UPDATED=dispatch_fee_updated
WHATSAPP_TEMPLATE_PROMO=promo_broadcast

# AI (used by the Order Processing agent)
OPENAI_API_KEY=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

DEBUG=true